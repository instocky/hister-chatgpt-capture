{
  "manifest_version": 3,
  "name": "Hister ChatGPT Capture",
  "version": "0.2.0",
  "description": "Saves settled ChatGPT threads to the clipboard as Markdown.",
  "minimum_chrome_version": "120",

  "permissions": [
    "clipboardWrite",
    "activeTab"
  ],

  "host_permissions": [
    "*://chatgpt.com/*"
  ],

  "background": {
    "service_worker": "service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/c/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Hister ChatGPT Capture"
  },

  "commands": {
    "save-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Save the current ChatGPT thread to clipboard as Markdown"
    }
  }
}
