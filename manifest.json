{
  "manifest_version": 3,
  "name": "Hister ChatGPT Capture",
  "version": "0.1.0",
  "description": "Auto-captures settled ChatGPT threads into a local Hister instance.",
  "minimum_chrome_version": "120",

  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "*://chatgpt.com/*",
    "http://127.0.0.1:4433/*"
  ],

  "background": {
    "service_worker": "service_worker.js"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hister-csrf-bypass",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/c/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Hister ChatGPT Capture"
  }
}
